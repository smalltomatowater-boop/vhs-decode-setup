--- gvusb2.h.orig	2026-11-01 22:08:26.452272453 +0900
+++ gvusb2.h	2026-11-01 22:08:26.476136475 +0900
@@ -15,8 +15,14 @@
 
 #include <linux/module.h>
 
-#define GVUSB2_NUM_URBS 4
-#define GVUSB2_NUM_ISOCH_PACKETS 0x100
+/* [local patch] On EHCI hosts with more than 4GB of RAM and no IOMMU, DMA goes
+ * through swiotlb bounce buffers, where a single mapping cannot exceed 256KB.
+ * The original values request 0x100 packets * 0xc00 bytes = 786432 bytes,
+ * which fails with "swiotlb buffer is full" -> urb submit failed (-11).
+ * Quartering the packet count gives 0x40 * 0xc00 = 196608 bytes, and the lost
+ * buffering is made up for by doubling the number of URBs. */
+#define GVUSB2_NUM_URBS 8
+#define GVUSB2_NUM_ISOCH_PACKETS 0x40
 #define GVUSB2_MAX_AUDIO_PACKET_SIZE 0x100
 #define GVUSB2_MAX_VIDEO_PACKET_SIZE 0xc00
 #define GVUSB2_VENDOR_ID  0x04bb
