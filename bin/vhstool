#!/bin/bash
# vhstool - VHSのRFキャプチャと通常キャプチャを合体させる自動化ツール
set -uo pipefail

WORK=/mnt/rf
BIN=$HOME/src/tbc-tools/build/bin
VENV=$HOME/.local/share/pipx/venvs/vhs-decode/bin/python
# $BIN を先に置く。~/.local/bin には古い tbc-video-export 0.1.8 が残っていて、
# これは旧名 ld-dropout-correct を探すため必ず失敗する。
PATH="$BIN:$HOME/.local/bin:$PATH"
CXDEV=/dev/cxadc0
RFRATE=28.636363
PARAMS=/sys/class/cxadc/cxadc0/device/parameters
NAS="${VHS_NAS_DIR:-/mnt/rftmp}"   # 完成品の置き場。off にすると転送しない

c()  { printf '\033[1;36m%s\033[0m\n' "$*"; }
ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
ng() { printf '  \033[31m✗\033[0m %s\n' "$*"; }
wn() { printf '  \033[33m!\033[0m %s\n' "$*"; }

find_video() { ls /dev/video* 2>/dev/null | head -1; }
free_dev() {
  # 前のキャプチャが残っていると Device or resource busy になるので先に解放する
  local v=$1
  [ -n "$v" ] || return 0
  fuser "$v" >/dev/null 2>&1 || return 0
  wn "$v を掴んでいるプロセスがあるので終了させる"
  fuser -k "$v" 2>/dev/null
  sleep 2
  fuser "$v" >/dev/null 2>&1 && { ng "$v を解放できなかった"; return 1; }
  ok "$v を解放した"
}

setup_video() {
  # 収録前に毎回 入力端子と映像規格を設定する。
  # VHS_V4L_INPUT: 0=Composite 1=S-Video (既定 1)
  local v=$1
  [ -n "$v" ] || return 0
  v4l2-ctl -d "$v" --set-input "${VHS_V4L_INPUT:-1}" >/dev/null 2>&1
  v4l2-ctl -d "$v" --set-standard "${VHS_V4L_STANDARD:-ntsc}" >/dev/null 2>&1
}

find_audio() {
  # PCH(マザボ)以外のキャプチャカードを優先、無ければPCHのライン入力
  local n
  n=$(arecord -l 2>/dev/null | grep -oP '^(カード|card)\s+\K[0-9]+(?=.*)' | while read -r i; do
        grep -qi 'pch\|hda intel' <(arecord -l | grep -E "^(カード|card) +$i:") || echo "$i"
      done | head -1)
  [ -n "${n:-}" ] && { echo "plughw:$n,0"; return; }
  echo "plughw:0,0"
}

cmd_check() {
  c "=== 環境チェック ==="
  [ -c $CXDEV ] && ok "RFキャプチャ $CXDEV" || { ng "$CXDEV が無い（cxadc未ロード）"; return 1; }
  printf '    設定: '; for f in vmux level sixdb tenbit; do printf '%s=%s ' "$f" "$(cat $PARAMS/$f)"; done; echo

  local v; v=$(find_video)
  [ -n "$v" ] && { setup_video "$v"; ok "映像キャプチャ $v  入力=$(v4l2-ctl -d "$v" --get-input 2>/dev/null | grep -oP ": \\K.*" | head -1)"
    v4l2-ctl -d "$v" --list-formats 2>/dev/null | grep -oP "\[\d+\]: '\K[^']+" | tr '\n' ' ' | sed 's/^/    対応形式: /'; echo
  } || ng "USBキャプチャが見つからない（挿してる？）"

  local a; a=$(find_audio); ok "音声入力 $a"

  local avail min
  avail=$(df --output=avail -k "$WORK" | tail -1)
  min=$(( avail / 1024 / 28 / 60 ))
  ok "空き $(df -h "$WORK" | awk 'NR==2{print $4}') → 無圧縮で約 ${min} 分"
  [ "$min" -lt 70 ] && wn "2時間テープには足りない。--flac を使うか古いファイルを消して"

  c "=== RF信号レベル（3秒） ==="
  free_dev "$CXDEV" >/dev/null 2>&1
  timeout 3 cat $CXDEV > /tmp/_lv.u8 2>/dev/null
  $VENV - <<'PY'
import numpy as np
x = np.fromfile('/tmp/_lv.u8', dtype=np.uint8)
if x.size < 100_000:
    print("  \033[31mデータを読めなかった。デバイスが他のプロセスに使われている可能性\033[0m")
    raise SystemExit
x = x[x.size//4 : x.size//4 + 6_000_000]
sd, c0, c1 = x.std(), (x==0).mean()*100, (x==255).mean()*100
print(f"  標準偏差 {sd:.2f}  クリップ {c0+c1:.4f}%")
if sd < 5:      print("  \033[31m信号が弱い。デッキは再生中？\033[0m")
elif c0+c1>0.1: print("  \033[33mクリップ過多。level を下げて\033[0m")
else:           print("  \033[32m良好\033[0m")
PY
  rm -f /tmp/_lv.u8
}

cmd_rec() {
  local name=$1 dur=${2:-}
  local v a; v=$(find_video); a=$(find_audio)
  [ -c $CXDEV ] || { ng "$CXDEV が無い"; return 1; }

  mkdir -p "$WORK/$name"
  local rf="$WORK/$name/rf.u8" ref="$WORK/$name/ref.mkv" meta="$WORK/$name/meta.json"

  c "=== 収録開始: $name ==="
  [ -n "$dur" ] && echo "  長さ: ${dur}秒" || echo "  長さ: Ctrl-C で停止"
  echo "  RF   → $rf"
  [ -n "$v" ] && echo "  参照 → $ref  ($v + $a)" || wn "映像キャプチャ無し。RFのみ収録する"

  local rfpid refpid
  free_dev "$v"; free_dev "$CXDEV"
  setup_video "$v"
  if [ -n "$v" ]; then
    # -fps_mode cfr で等間隔出力を保証する。デバイスがフレームを落としても
    # フレーム番号と時刻の対応が崩れず、相互相関での同期計算が成立する
    ffmpeg -nostdin -v error -y \
      -f v4l2 -framerate 30000/1001 -thread_queue_size 512 -i "$v" \
      -f alsa -thread_queue_size 512 -i "$a" \
      -fps_mode cfr -r 30000/1001 \
      -c:v libx264 -preset ultrafast -crf 26 -c:a flac "$ref" &
    refpid=$!
    # ffmpegが実際に書き始めるまで待つ（起動遅延を吸収）
    for _ in $(seq 100); do [ -s "$ref" ] && break; sleep 0.05; done
  fi
  local t0; t0=$(date +%s.%N)
  cat $CXDEV > "$rf" & rfpid=$!

  stop() {
    echo; c "停止中..."
    kill -INT ${refpid:-0} 2>/dev/null
    kill ${rfpid:-0} 2>/dev/null
    wait ${rfpid:-0} ${refpid:-0} 2>/dev/null
  }
  trap stop INT TERM

  if [ -n "$dur" ]; then
    local i=0
    while [ $i -lt "$dur" ] && kill -0 $rfpid 2>/dev/null; do
      sleep 1; i=$((i+1))
      printf '\r  録画中 %4d/%s 秒   RF %6d MB' "$i" "$dur" "$(( $(stat -c%s "$rf" 2>/dev/null || echo 0) / 1048576 ))"
    done
    echo; stop
  else
    wait $rfpid
    stop
  fi
  trap - INT TERM

  printf '{"name":"%s","t0":%s,"rf_rate":%s,"video_dev":"%s","audio_dev":"%s","vmux":%s,"level":%s,"sixdb":%s}\n' \
    "$name" "$t0" "$RFRATE" "${v:-none}" "$a" "$(cat $PARAMS/vmux)" "$(cat $PARAMS/level)" "$(cat $PARAMS/sixdb)" > "$meta"

  ok "RF   $(du -h "$rf" | cut -f1)"
  [ -f "$ref" ] && ok "参照 $(du -h "$ref" | cut -f1)"
}

cmd_pbuild() {
  # 区間を分けて並列にデコードする。
  # vhs-decode 1本では8コア中2.7コアしか使えず6割が遊ぶため、
  # 複数本を別区間に走らせたほうが総スループットが上がる。
  local name=$1 workers=${2:-3} d="$WORK/$1" rf="$WORK/$1/rf.u8"
  local overlap=${VHS_OVERLAP:-60}      # 境目で捨てる重なりフレーム数
  [ -f "$rf" ] || { ng "$rf が無い"; return 1; }

  local total
  total=$($VENV -c "
import os
# RFのバイト数から総フレーム数を見積もる（28.636363MSPS / 29.97fps）
print(int(os.path.getsize('$rf') / 28_636_363 * 30000/1001))")
  local chunk=$(( (total + workers - 1) / workers ))

  c "=== 並列デコード: $name ==="
  echo "  総フレーム数(推定) $total / $workers 分割 / 1区間 $chunk フレーム"
  echo "  重なり $overlap フレーム（境目で捨てる）"

  local pids=() i
  for ((i=0; i<workers; i++)); do
    local s=$(( i*chunk )) l=$chunk
    if [ $i -gt 0 ]; then s=$(( s - overlap )); l=$(( l + overlap )); fi
    echo "  [$i] フレーム $s から $l 本"
    ( vhs-decode --tf VHS --system NTSC -f $RFRATE -t 3 \
        -s "$s" -l "$l" --overwrite "$rf" "$d/seg$i" > "$d/seg$i.declog" 2>&1 ) &
    pids+=($!)
  done
  echo "  $workers 本を並列実行中..."
  local fail=0
  for pid in "${pids[@]}"; do wait "$pid" || fail=1; done
  [ $fail = 1 ] && { ng "デコードに失敗した区間がある"; return 1; }
  ok "全区間のデコード完了"

  c "=== 区間ごとに書き出し ==="
  for ((i=0; i<workers; i++)); do
    [ -f "$d/seg$i.tbc" ] || { ng "seg$i.tbc が無い"; return 1; }
    "$BIN/tbc-video-export" --threads "$(nproc)" --chroma-decoder ntsc3d \
      "$d/seg$i.tbc" "$d/segv$i" > /dev/null 2>&1
    [ -f "$d/segv$i.mkv" ] || { ng "seg$i の書き出しに失敗"; return 1; }
    echo "  [$i] $(du -h "$d/segv$i.mkv" | cut -f1)"
  done

  c "=== 連結 ==="
  # FFV1は全フレームがキーフレームなので、-ss + -c copy で正確かつ可逆に切れる
  local skip; skip=$($VENV -c "print($overlap/(30000/1001))")
  : > "$d/concat.txt"
  for ((i=0; i<workers; i++)); do
    if [ $i -eq 0 ]; then
      echo "file '$d/segv$i.mkv'" >> "$d/concat.txt"
    else
      ffmpeg -nostdin -v error -y -ss "$skip" -i "$d/segv$i.mkv" -c copy "$d/segt$i.mkv"
      echo "file '$d/segt$i.mkv'" >> "$d/concat.txt"
    fi
  done
  ffmpeg -nostdin -v error -y -f concat -safe 0 -i "$d/concat.txt" -c copy "$d/video.mkv"
  [ -f "$d/video.mkv" ] || { ng "連結に失敗"; return 1; }
  ok "映像 $(du -h "$d/video.mkv" | cut -f1)"

  c "=== 整合性検査 ==="
  local crc; crc=$(ffmpeg -v error -i "$d/video.mkv" -f null - 2>&1 | grep -c "CRC mismatch")
  [ "$crc" = "0" ] && ok "CRC不一致なし" || wn "CRC不一致 $crc 件"

  rm -f "$d"/seg*.tbc "$d"/seg*_chroma.tbc "$d"/seg*.tbc.json "$d"/seg*.declog \
        "$d"/segv*.mkv "$d"/segt*.mkv "$d"/concat.txt
  echo "  区間ファイルを削除した"
}

cmd_build() {
  local name=$1
  local d="$WORK/$name"
  local rf="$d/rf.u8" ref="$d/ref.mkv"
  [ -f "$rf" ] || { ng "$rf が無い"; return 1; }

  c "=== 1/4 RFをデコード ==="
  # 出力を一度ファイルに落としてから必要な行だけ見せる。
  # 以前は直接 grep に通していたため、落ちたときのエラーが1行も残らず、
  # 0バイトのTBCのまま次の工程へ進んでいた（tape03 で SIGSEGV を見逃した）。
  local declog="$d/decode.out"
  vhs-decode --tf VHS --system NTSC -f $RFRATE -t "$(nproc)" --overwrite "$rf" "$d/dec" \
    > "$declog" 2>&1
  local rc=$?
  grep -E 'Took|Completed' "$declog" | sed 's/^/  /'
  local sz; sz=$(stat -c%s "$d/dec.tbc" 2>/dev/null || echo 0)
  if [ "$rc" -ne 0 ] || [ "$sz" -lt 1000000 ]; then
    ng "デコード失敗（終了コード $rc / dec.tbc $sz バイト）"
    echo "  --- 出力の末尾20行 ---"
    tail -20 "$declog" | sed 's/^/  /'
    echo "  --- ここまで ---"
    [ "$rc" -ge 128 ] && wn "シグナル $((rc-128)) で落ちた。11ならSIGSEGV＝メモリを疑うこと"
    return 1
  fi
  ok "TBC $(du -h "$d/dec.tbc" | cut -f1) ×2"

  c "=== 2/4 カラー化して書き出し ==="
  rm -f "$d/video.mkv"
  local explog="$d/export.out"
  "$BIN/tbc-video-export" --threads "$(nproc)" --chroma-decoder ntsc3d \
    "$d/dec.tbc" "$d/video" > "$explog" 2>&1
  local erc=$?
  grep -iE 'export finished|error' "$explog" | sed 's/^/  /'
  if [ "$erc" -ne 0 ] || [ ! -s "$d/video.mkv" ]; then
    ng "書き出し失敗（終了コード ${erc}）"
    echo "  --- 出力の末尾20行 ---"
    tail -20 "$explog" | tr '\r' '\n' | tail -20 | sed 's/^/  /'
    return 1
  fi
  ok "映像 $(du -h "$d/video.mkv" | cut -f1)"

  if [ ! -f "$ref" ]; then
    wn "参照キャプチャが無いので音声なしで完成"
    cp "$d/video.mkv" "$d/$name.mkv"; ok "$d/$name.mkv"; return 0
  fi

  c "=== 3/4 映像を突き合わせて同期を計算 ==="
  $VENV "$HOME/bin/vhsalign.py" "$d/video.mkv" "$ref" || { ng "同期計算に失敗"; return 1; }

  c "=== 4/4 音声を合体 ==="
  local trim drift conf
  trim=$($VENV -c "import json;print(json.load(open('/tmp/vhsalign.json'))['trim_sec'])")
  drift=$($VENV -c "import json;print(json.load(open('/tmp/vhsalign.json'))['drift'])")
  conf=$($VENV -c "import json;print(json.load(open('/tmp/vhsalign.json'))['confidence'])")
  [ "$conf" = "低い" ] && wn "同期の信頼度が低い。できた動画の音ズレを確認して"

  # 参照が先に始まっていれば先頭を切り落とす(-ss)。逆なら遅らせる(-itsoffset)。
  local ain
  if $VENV -c "import sys;sys.exit(0 if $trim >= 0 else 1)"; then
    ain="-ss $trim"
    echo "  参照の先頭 ${trim} 秒を切り落として頭を揃える"
  else
    local neg; neg=$($VENV -c "print(-($trim))")
    ain="-itsoffset $neg"
    echo "  参照を ${neg} 秒ぶん遅らせて頭を揃える"
  fi

  local rate; rate=$($VENV -c "print(48000*$drift)")
  # shellcheck disable=SC2086
  ffmpeg -nostdin -v error -y \
    -i "$d/video.mkv" $ain -i "$ref" \
    -map 0:v -map 1:a \
    -af "asetrate=$rate,aresample=48000:resampler=soxr" \
    -c:v copy -c:a flac -compression_level 8 \
    -shortest "$d/$name.mkv"

  # 自己検証: 音声トラックの開始時刻が映像と揃っているか。
  # 符号を間違えるとここが大きくずれるので、気づかないまま完成させない。
  local ast
  ast=$(ffprobe -v error -select_streams a:0 -show_entries stream=start_time \
        -of default=nw=1:nk=1 "$d/$name.mkv" 2>/dev/null)
  if $VENV -c "import sys;sys.exit(0 if abs(float('${ast:-0}')) <= 0.2 else 1)" 2>/dev/null; then
    ok "音声の開始時刻 ${ast}s（映像と揃っている）"
  else
    ng "音声の開始時刻が ${ast}s もずれている。同期の符号を疑うこと"
  fi
  [ -f "$d/$name.mkv" ] || { ng "合体に失敗"; return 1; }
  ok "完成 → $d/$name.mkv  ($(du -h "$d/$name.mkv" | cut -f1))"
  make_clips "$name" || wn "確認用クリップを作れなかった"
  cmd_push "$name" || wn "転送は後で vhstool push $name を実行すること"
}

cmd_watch() {
  local name=${1:-$(date +tape_%Y%m%d_%H%M)}
  local TH=${VHS_THRESHOLD:-6.0}      # 信号ありと判定する標準偏差
  local ON=${VHS_ON_COUNT:-3}         # 何回連続で検出したら録画開始するか
  local OFF=${VHS_OFF_COUNT:-15}      # 何回連続で無信号なら停止するか

  c "=== 信号待ち受けモード ==="
  echo "  名前     : $name"
  echo "  しきい値 : 標準偏差 $TH 以上を「信号あり」とみなす"
  echo "  開始条件 : ${ON}回連続で検出"
  echo "  停止条件 : ${OFF}回連続で無信号（約${OFF}秒）"
  echo "  デッキの再生ボタンを押せば自動で始まる。Ctrl-C で待ち受け自体を終了。"
  echo

  local hit=0 lv
  while true; do
    lv=$($VENV "$HOME/bin/vhslevel.py" "$TH"); local rc=$?
    if [ $rc -eq 0 ]; then hit=$((hit+1)); else hit=0; fi
    printf '\r  待機中... レベル %-6s 連続検出 %d/%d ' "$lv" "$hit" "$ON"
    [ $hit -ge "$ON" ] && break
    sleep 1
  done
  echo; ok "信号を検出。収録を開始する"

  # --- 収録開始（cmd_rec と同じ構成だが、無信号で自動停止する） ---
  local v a; v=$(find_video); a=$(find_audio)
  mkdir -p "$WORK/$name"
  local rf="$WORK/$name/rf.u8" ref="$WORK/$name/ref.mkv" meta="$WORK/$name/meta.json"
  local rfpid refpid=""
  free_dev "$v"; free_dev "$CXDEV"
  setup_video "$v"
  if [ -n "$v" ]; then
    # -fps_mode cfr で等間隔出力を保証する。デバイスがフレームを落としても
    # フレーム番号と時刻の対応が崩れず、相互相関での同期計算が成立する
    ffmpeg -nostdin -v error -y \
      -f v4l2 -framerate 30000/1001 -thread_queue_size 512 -i "$v" \
      -f alsa -thread_queue_size 512 -i "$a" \
      -fps_mode cfr -r 30000/1001 \
      -c:v libx264 -preset ultrafast -crf 26 -c:a flac "$ref" &
    refpid=$!
    for _ in $(seq 100); do [ -s "$ref" ] && break; sleep 0.05; done
  fi
  local t0; t0=$(date +%s.%N)
  cat $CXDEV > "$rf" & rfpid=$!

  stopall() {
    echo; c "停止中..."
    [ -n "$refpid" ] && kill -INT $refpid 2>/dev/null
    kill $rfpid 2>/dev/null
    wait $rfpid ${refpid:-} 2>/dev/null
  }
  trap 'stopall; exit 130' INT TERM

  # 録画中は別ディスクリプタで監視できないので、サイズの伸びと経過で見る
  local quiet=0 sec=0 prev=0 now
  local t_start; t_start=$(date +%s)
  while kill -0 $rfpid 2>/dev/null; do
    sleep 1
    sec=$(( $(date +%s) - t_start ))      # ループ1周は1秒より長いので実時刻で測る
    now=$(stat -c%s "$rf" 2>/dev/null || echo 0)
    # 直近1秒ぶんの末尾を読んで信号レベルを見る
    lv=$(tail -c 3000000 "$rf" 2>/dev/null | $VENV -c "
import sys,numpy as np
b=sys.stdin.buffer.read()
x=np.frombuffer(b,dtype=np.uint8)
print(f'{x.std():.2f}' if x.size>1000 else '0')
")
    if [ "$(echo "$lv < $TH" | bc -l)" = "1" ]; then quiet=$((quiet+1)); else quiet=0; fi
    printf '\r  録画中 %5d秒  %6d MB  レベル %-6s 無信号 %d/%d ' \
      "$sec" "$(( now / 1048576 ))" "$lv" "$quiet" "$OFF"
    if [ $quiet -ge "$OFF" ]; then echo; wn "無信号が続いたので停止する"; break; fi
    prev=$now
  done
  stopall
  trap - INT TERM

  printf '{"name":"%s","t0":%s,"rf_rate":%s,"video_dev":"%s","audio_dev":"%s","auto":true}\n' \
    "$name" "$t0" "$RFRATE" "${v:-none}" "$a" > "$meta"
  ok "RF   $(du -h "$rf" | cut -f1)"
  [ -f "$ref" ] && ok "参照 $(du -h "$ref" | cut -f1)"

  # ここから先をこの機でやるかどうか。
  # 搭載メモリに不良があり、デコードが SIGSEGV で落ちる／書き出しが静かに
  # ビットを壊す（tape01.mkv に19か所焼き付けて失った）。そのため既定では
  # 収録だけ行い、原本をNASへ送って Mac の vhsfinish に渡す。
  # メモリを交換して3回読み検査が通ったら VHS_BUILD_HERE=1 で元に戻せる。
  if [ "${VHS_BUILD_HERE:-0}" = 1 ]; then
    c "=== 仕上げに入る（この機で）==="
    wn "VHS_BUILD_HERE=1。メモリ不良が直っていることを確認済みか？"
    cmd_build "$name"
  else
    c "=== 原本をNASへ送る ==="
    cmd_pushrf "$name" || { wn "転送できなかった。後で vhstool pushrf $name を実行すること"; return 1; }
    echo
    c "=== この機での作業は終わり ==="
    echo "  続きは Mac で:"
    echo "      vhsfinish $name"
    echo "  この機で仕上げまでやるなら（メモリ交換後）:"
    echo "      VHS_BUILD_HERE=1 vhstool build $name"
  fi
}

cmd_pushrf() {
  # 原本RFと参照キャプチャをNASへ送る。名前は Mac 側の vhsfinish が探す形
  # （rf_<名前>.u8 / ref_<名前>.mkv）に合わせる。
  local name=$1 d="$WORK/$1"
  [ "$NAS" = "off" ] && { wn "VHS_NAS_DIR=off なので転送しない"; return 0; }
  [ -d "$NAS" ] || { ng "$NAS が見えない（NASがマウントされていない）"; return 1; }
  # 転送中のファイルを完成品と見分けられるよう、一時名で送ってから改名する。
  # rsync --inplace は最終的な名前のまま書き進めるので、そのままだと
  # Mac 側の vhsfinish が「もう在る」と判断して途中のRFをデコードし始める。
  # 同じ共有の中なので改名は一瞬かつ不可分。
  local pair src tmp dst a b
  for pair in "rf.u8 rf_${name}.u8" "ref.mkv ref_${name}.mkv"; do
    set -- $pair; src="$d/$1"; dst="$NAS/$2"; tmp="$NAS/.$2.part"
    [ -f "$src" ] || { wn "$src が無いので飛ばす"; continue; }
    echo "  $1 → $2  ($(du -h "$src" | cut -f1))"
    rsync -h --inplace "$src" "$tmp" || { ng "転送失敗 $1"; return 1; }
    a=$(stat -c%s "$src"); b=$(stat -c%s "$tmp" 2>/dev/null || echo 0)
    if [ "$a" != "$b" ]; then
      ng "サイズが合わない（元 $a / 先 ${b}）。一時ファイルを残すので調べること: $tmp"
      return 1
    fi
    mv -f "$tmp" "$dst" || { ng "改名に失敗 $tmp → $dst"; return 1; }
    ok "$a バイト一致  →  $2"
  done
}

make_clips() {
  # 完成品から短い確認用クリップを作ってNASに置く。
  # 音ズレの確認には再生用PCで再生する必要があり、そのためにはNAS上に
  # 無いと始まらない。本体20GBの転送を待たずに検証できるようにする。
  local name=$1 src="$WORK/$1/$1.mkv"
  [ -f "$src" ] || return 1
  local dur; dur=$($VENV -c "
import subprocess
o=subprocess.run(['ffprobe','-v','error','-show_entries','format=duration',
                  '-of','default=nw=1:nk=1','$src'],capture_output=True,text=True).stdout
print(int(float(o)))" 2>/dev/null)
  [ -n "$dur" ] || return 1
  c "=== 確認用クリップを作成 ==="
  local out="$NAS/_確認用"
  [ "$NAS" = "off" ] && out="$WORK/$name/_確認用"
  mkdir -p "$out" 2>/dev/null || return 1
  local i=1
  for T in $((dur/14)) $((dur/2)) $((dur*93/100)); do
    ffmpeg -nostdin -v error -y -ss "$T" -i "$src" -t 20 \
      -vf "yadif,scale=640:480:flags=lanczos,setsar=1" \
      -c:v libx264 -preset veryfast -crf 23 -c:a aac -b:a 128k \
      "$out/${name}_確認_${i}.mp4" 2>/dev/null
    printf '  %d本目 %02d:%02d から20秒  %s\n' "$i" $((T/60)) $((T%60)) \
      "$(du -h "$out/${name}_確認_${i}.mp4" 2>/dev/null | cut -f1)"
    i=$((i+1))
  done
  ok "$out に配置"
  echo "  再生用PCで3本とも確認すること。特に3本目（終盤）でズレが増えていないか"
}

cmd_push() {
  local name=$1 src="$WORK/$1/$1.mkv"
  [ "$NAS" = "off" ] && { wn "VHS_NAS_DIR=off なので転送しない"; return 0; }
  [ -f "$src" ] || { ng "完成品 $src が無い"; return 1; }
  mkdir -p "$NAS" 2>/dev/null
  [ -d "$NAS" ] || { ng "$NAS が見えない（NASがマウントされていない）"; return 1; }
  local sz; sz=$(stat -c%s "$src")
  c "=== NASへ転送: $name ==="
  echo "  $src  ($(( sz / 1048576 )) MB)"
  echo "  → $NAS/$name.mkv"
  if command -v rsync >/dev/null; then
    rsync -h --inplace "$src" "$NAS/$name.mkv"
  else
    cp "$src" "$NAS/$name.mkv"
  fi
  local dsz; dsz=$(stat -c%s "$NAS/$name.mkv" 2>/dev/null || echo 0)
  if [ "$dsz" = "$sz" ]; then
    ok "転送完了（サイズ一致 $sz バイト）"
  else
    ng "サイズが合わない（元 $sz / 先 ${dsz}）"; return 1
  fi
}

cmd_clean() {
  local name=$1 mode=${2:-tbc} d="$WORK/$1"
  [ -d "$d" ] || { ng "$d が無い"; return 1; }
  [ -f "$d/$name.mkv" ] || { ng "完成品 $name.mkv がまだ無い。消すのは完成してから"; return 1; }
  local before; before=$(du -sm "$d" | cut -f1)
  c "=== 不要ファイルの削除: $name ==="
  rm -f "$d"/dec.tbc "$d"/dec_chroma.tbc "$d"/dec.tbc.json "$d"/dec.log "$d"/video.mkv
  if [ "$mode" = "all" ]; then
    local ok_nas=0
    if [ "$NAS" != "off" ] && [ -f "$NAS/$name.mkv" ]; then
      [ "$(stat -c%s "$NAS/$name.mkv")" = "$(stat -c%s "$d/$name.mkv")" ] && ok_nas=1
    fi
    if [ "$ok_nas" = "1" ]; then
      rm -f "$d"/rf.u8 "$d"/ref.mkv
      echo "  rf.u8 と ref.mkv も削除（NAS上の完成品をサイズ照合して確認済み）"
    else
      wn "NAS上に完成品が無いかサイズが一致しない。rf.u8 は残した"
    fi
  else
    echo "  残したもの: $name.mkv / rf.u8 / ref.mkv / meta.json"
  fi
  local after; after=$(du -sm "$d" | cut -f1)
  ok "$((before-after)) MB 解放（$before MB → $after MB）"
}

cmd_list() {
  c "=== 収録一覧 ($WORK) ==="
  printf '  %-18s %8s %8s %8s  %s\n' 名前 RF 参照 完成品 更新
  for d in "$WORK"/*/; do
    [ -d "$d" ] || continue
    local n; n=$(basename "$d")
    printf '  %-18s %8s %8s %8s  %s\n' "$n" \
      "$([ -f "$d/rf.u8" ] && du -h "$d/rf.u8" | cut -f1 || echo -)" \
      "$([ -f "$d/ref.mkv" ] && du -h "$d/ref.mkv" | cut -f1 || echo -)" \
      "$([ -f "$d/$n.mkv" ] && du -h "$d/$n.mkv" | cut -f1 || echo -)" \
      "$(date -r "$d" '+%m/%d %H:%M')"
  done
  echo; df -h "$WORK" | awk 'NR==2{print "  空き: "$4" / "$2}'
}

usage() {
cat <<'U'
vhstool - VHSのRF+通常キャプチャ自動化

  vhstool check            環境チェック（デバイス・空き容量・信号レベル）
  vhstool rec 名前 [秒]     RFと参照キャプチャを同時収録（秒を省略するとCtrl-Cまで）
  vhstool build 名前        デコード→カラー化→音声合体
  vhstool pbuild 名前 [並列数] 区間を分けて並列デコード（既定3本。映像のみ）
  vhstool auto 名前 [秒]    rec と build を続けて実行
  vhstool watch [名前]      信号を待ち受け、再生を検出したら自動で収録→NASへ転送
  vhstool pushrf 名前       原本RFと参照キャプチャをNASへ送る（Macで仕上げる用）
  vhstool clips 名前        確認用の短いクリップを作ってNASに置く
  vhstool push 名前         完成品をNASへ転送（buildの最後に自動実行される）
  vhstool clean 名前        中間ファイル(TBC等)を削除。完成品とrf.u8は残す
  vhstool clean 名前 all    NAS転送済みを確認した上で rf.u8 も削除
  vhstool list             収録一覧

  例:  vhstool watch tape01         再生ボタンを押すまで待ち、録れたらNASへ送る
       → そのあと Mac で  vhsfinish tape01

  この機は収録までを担当する。デコードと書き出しは Mac で行う。
  搭載メモリに不良があり、デコードが落ちる・書き出しが静かにビットを壊す
  ため。メモリ交換後は VHS_BUILD_HERE=1 でこの機でも仕上げられる。

  環境変数:
    VHS_THRESHOLD(既定6.0) VHS_ON_COUNT(3) VHS_OFF_COUNT(15)
    VHS_V4L_INPUT(既定1=S-Video, 0=Composite) VHS_V4L_STANDARD(既定ntsc)
    VHS_NAS_DIR(既定 /mnt/rftmp, off で転送しない)
    VHS_BUILD_HERE(既定0。1にすると watch がこの機で仕上げまでやる)
U
}

case "${1:-}" in
  check) cmd_check ;;
  rec)   cmd_rec "${2:?名前が必要}" "${3:-}" ;;
  watch) cmd_watch "${2:-}" ;;
  build) cmd_build "${2:?名前が必要}" ;;
  pbuild) cmd_pbuild "${2:?名前が必要}" "${3:-3}" ;;
  auto)  cmd_rec "${2:?名前が必要}" "${3:-}" && cmd_build "$2" ;;
  clips) make_clips "${2:?名前が必要}" ;;
  push)  cmd_push  "${2:?名前が必要}" ;;
  pushrf) cmd_pushrf "${2:?名前が必要}" ;;
  clean) cmd_clean "${2:?名前が必要}" "${3:-}" ;;
  list)  cmd_list ;;
  *)     usage ;;
esac
