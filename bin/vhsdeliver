#!/bin/bash
# vhsdeliver <名前またはmkvのパス> [プロファイル]
#
#   vhsdeliver tape01                                  標準版（standard-v1）
#   vhsdeliver tape01 contrast-v1                      コントラスト重視版
#   vhsdeliver "/Volumes/rf_mkv/作品名.mkv"              改名済みマスターを直接渡す
#
# マスターは作品名に改名して運用するので、名前で引けないときは
# ファイルそのものを渡せるようにしてある。出力名はマスターの名前から作る。
#
# 保存マスター 完成_<名前>.mkv から納品用 MP4 を作る。
# マスターには一切触れない。
#
# パラメータは profiles/<プロファイル>.sh に凍結してある。ここでは変更しない。
# 設定を変えたいときは新しいバージョンのプロファイルを作り、
# docs/verify-standard-v1.md と同じ検証を通してから採用すること。
# 毎回パラメータを触る運用にすると品質の再現性が失われる。
set -uo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
REPO=$(dirname "$HERE")
ARG=${1:-}
PROF=${2:-standard-v1}
# 置き場はNASの共有ごとに分かれている（home の下のフォルダではない）
MKVDIR="${VHS_MKV_DIR:-/Volumes/rf_mkv}"
MP4DIR="${VHS_MP4_DIR:-/Volumes/rf_mp4}"

[ -n "$ARG" ] || { echo "使い方: vhsdeliver <名前またはmkvのパス> [プロファイル]"; exit 2; }
P="$REPO/profiles/$PROF.sh"
[ -f "$P" ] || { echo "プロファイルが無い: $P"; exit 2; }
# shellcheck source=/dev/null
. "$P"

# 引数がファイルならそれをマスターとして使い、そうでなければ名前として扱う。
if [ -f "$ARG" ]; then
  SRC="$ARG"
else
  SRC="$MKVDIR/完成_$ARG.mkv"
fi
[ -f "$SRC" ] || {
  echo "保存マスターが無い: $SRC"
  echo "  改名してあるなら、そのファイルを直接渡すこと:"
  echo "    vhsdeliver \"$MKVDIR/<ファイル名>.mkv\" $PROF"
  exit 1
}

# 出力名はマスターの名前から作る。完成_ の接頭辞は落とす。
BASE=$(basename "$SRC" .mkv); BASE=${BASE#完成_}
mkdir -p "$MP4DIR" 2>/dev/null || { echo "$MP4DIR が見えない（共有がマウントされていない）"; exit 1; }
OUT="$MP4DIR/${BASE}_${PROFILE_LABEL}.mp4"

# マスターのレンジ表記を確認する。tbc-video-export の出力はフルレンジだが
# タグが tv のまま出ることがあり、そのままだと変換が二重にかかる。
RNG=$(ffprobe -v error -select_streams v:0 -show_entries stream=color_range -of csv=p=0 "$SRC")
if [ "$RNG" != "pc" ]; then
  echo "警告: マスターの color_range が ${RNG} になっている。"
  echo "      tbc-video-export の出力はフルレンジなので pc が正しい。"
  echo "      mkvpropedit \"$SRC\" --edit track:v1 --set colour-range=2 で直せる（無劣化）。"
  exit 1
fi

VF="$DEINTERLACE,$CROP"
VF="$VF,lutyuv=y='clip((val-$BLACK)*1023/(1023-$BLACK),0,1023)'"
VF="$VF,$NR,$SCALE"

echo "=== ${PROFILE_NAME}（黒点 ${BLACK}）  $(date +%H:%M:%S) ==="
echo "  入力 $SRC"
echo "  出力 $OUT"
ffmpeg -nostdin -v error -i "$SRC" -vf "$VF" \
  "${VCODEC[@]}" "${VTAGS[@]}" "${ACODEC[@]}" "${MUXOPT[@]}" -y "$OUT" || { echo "書き出しに失敗"; exit 1; }
echo "  $(du -h "$OUT" | cut -f1)  $(date +%H:%M:%S)"

echo
"$HERE/vhsverify" "$OUT" "$SRC"
